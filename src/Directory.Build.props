<Project>
    <PropertyGroup>
        <DotNetTargetFx>net10.0</DotNetTargetFx>
    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix>0.1.0</VersionPrefix>
        <!-- Override at build time: dotnet build -p:VersionSuffix=alpha.1 -->
        <VersionSuffix></VersionSuffix>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>
    </PropertyGroup>
</Project>
