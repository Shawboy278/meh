root = true

[*]
# Vertical guidelines at columns 80 and 120.
# ij_visual_guides: Rider/IntelliJ; guidelines: Visual Studio (Editor Guidelines extension).
ij_visual_guides = 80, 120
guidelines = 80, 120

[*.cs]
# Namespaces are flat per project: folders do not contribute namespace segments.
# Mirrors FoldersProvideNamespacesByDefault in meh.slnx.DotSettings.
dotnet_style_namespace_match_folder = false
# Namespaces are not required to match the file location (Rider/ReSharper CheckNamespace).
resharper_check_namespace_highlighting = none
